---
import Icon from './Icon.astro';

interface Props {
	title: string;
	body: string;
	href?: string;
	target?: string;
	icon?: string;
	accent?: string;
	animation?: string;
	id?: string;
}

const {
	href = '',
	title,
	body,
	target = '_self',
	icon,
	accent = 'green',
	animation = 'fade-up',
	id
} = Astro.props;

const isClickable = href !== '';
const Tag = isClickable ? 'a' : 'div';
---

<li class={`card glass card--${accent}`} data-aos={animation} id={id}>
	<Tag class="card-inner" href={href ? href : undefined} target={isClickable ? target : undefined} rel={target === '_blank' ? 'noopener noreferrer' : undefined}>
		{body.length < 70 ? (
			<>
				{icon && <span class="card-icon self-center" aria-hidden="true"><Icon name={icon} size={22} /></span>}
				<div class="card-body flex flex-col justify-center">
					<h2 class="card-title display">{title}</h2>
					<p class="card-text">{body}</p>
				</div>
			</>
		) : (
			<>
				<div class="flex flex-col gap-3">
					<div class="flex flex-row items-center gap-3">
						{icon && <span class="card-icon" aria-hidden="true"><Icon name={icon} size={22} /></span>}
						<h2 class="card-title display">{title}</h2>
					</div>
					<div class="card-body">
						<p class="card-text">{body}</p>
					</div>
				</div>
			</>
		)}
		{isClickable && (
			<span class="card-arrow" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</span>
		)}
	</Tag>
</li>

<style>
	.card {
		list-style: none;
		display: flex;
		padding: 1.5rem;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.3s ease, border-color 0.3s ease;
		overflow: hidden;
		position: relative;
	}
	.card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at top right, rgba(0,255,102,0.08), transparent 60%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}
	.card:hover {
		transform: translateY(-4px);
		border-color: var(--green-neon);
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5),
			0 0 24px rgba(0, 255, 102, 0.25);
	}
	.card:hover::before { opacity: 1; }

	.card--violet:hover { border-color: var(--violet-accent); box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5), 0 0 24px rgba(167, 139, 250, 0.3); }
	.card--violet::before { background: radial-gradient(circle at top right, rgba(167,139,250,0.1), transparent 60%); }
	.card--cyan:hover { border-color: var(--cyan-accent); box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5), 0 0 24px rgba(77, 255, 216, 0.3); }
	.card--cyan::before { background: radial-gradient(circle at top right, rgba(77,255,216,0.1), transparent 60%); }

	.card-inner {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		width: 100%;
		text-decoration: none;
		color: var(--text-primary);
	}
	.card-icon {
		font-size: 1.6rem;
		line-height: 1;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background: rgba(0, 255, 102, 0.08);
		border: 1px solid var(--border-glow);
	}
	.card--violet .card-icon { background: rgba(167, 139, 250, 0.1); border-color: rgba(167, 139, 250, 0.3); }
	.card--cyan .card-icon { background: rgba(77, 255, 216, 0.1); border-color: rgba(77, 255, 216, 0.3); }

	.card-body { flex: 1; min-width: 0; }
	.card-title {
		margin: 0 0 0.4rem;
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--text-primary);
		transition: color 0.25s ease;
	}
	.card-text {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.card:hover .card-title { color: var(--green-neon); }
	.card--violet:hover .card-title { color: var(--violet-accent); }
	.card--cyan:hover .card-title { color: var(--cyan-accent); }

	.card-arrow {
		align-self: center;
		color: var(--text-muted);
		transition: transform 0.3s ease, color 0.3s ease;
		flex-shrink: 0;
	}
	.card:hover .card-arrow {
		color: var(--green-neon);
		transform: translateX(4px);
	}
	.card--violet:hover .card-arrow { color: var(--violet-accent); }
	.card--cyan:hover .card-arrow { color: var(--cyan-accent); }
</style>
