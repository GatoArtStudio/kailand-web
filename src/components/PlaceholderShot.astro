---
interface Props {
	label?: string;
	aspect?: string;
	caption?: string;
	animation?: string;
	animation_time?: string;
};

const {
	label = 'Vista del launcher',
	aspect = '16 / 10',
	caption,
	animation = 'fade-up',
	animation_time = '0'
} = Astro.props;
---

<figure class="shot" data-aos={animation} data-aos-delay={animation_time}>
	<div class="shot-frame" style={`aspect-ratio: ${aspect}`}>
		<svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<defs>
				<linearGradient id="ph-bg" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#061410" />
					<stop offset="100%" stop-color="#0a1f14" />
				</linearGradient>
				<linearGradient id="ph-glow" x1="0" y1="0" x2="1" y2="0">
					<stop offset="0%" stop-color="#00ff66" stop-opacity="0" />
					<stop offset="50%" stop-color="#00ff66" stop-opacity="0.6" />
					<stop offset="100%" stop-color="#00ff66" stop-opacity="0" />
				</linearGradient>
				<linearGradient id="ph-accent" x1="0" y1="0" x2="1" y2="0">
					<stop offset="0%" stop-color="#a78bfa" />
					<stop offset="100%" stop-color="#4dffd8" />
				</linearGradient>
			</defs>

			<rect width="800" height="500" fill="url(#ph-bg)" />

			<!-- Glow diagonal -->
			<rect x="-50" y="240" width="900" height="6" fill="url(#ph-glow)" opacity="0.4" />

			<!-- Top bar (window chrome) -->
			<rect x="0" y="0" width="800" height="42" fill="rgba(5,10,8,0.7)" />
			<circle cx="22" cy="21" r="6" fill="#ff5f56" />
			<circle cx="44" cy="21" r="6" fill="#ffbd2e" />
			<circle cx="66" cy="21" r="6" fill="#27c93f" />
			<rect x="200" y="12" width="400" height="18" rx="6" fill="rgba(0,255,102,0.08)" stroke="rgba(0,255,102,0.25)" stroke-width="1" />
			<rect x="208" y="17" width="120" height="8" rx="3" fill="rgba(0,255,102,0.45)" />

			<!-- Sidebar -->
			<rect x="0" y="42" width="180" height="458" fill="rgba(5,10,8,0.6)" />
			<rect x="22" y="78" width="130" height="14" rx="4" fill="rgba(0,255,102,0.6)" />
			<rect x="22" y="108" width="100" height="10" rx="3" fill="rgba(255,255,255,0.2)" />
			<rect x="22" y="130" width="115" height="10" rx="3" fill="rgba(255,255,255,0.15)" />
			<rect x="22" y="152" width="90" height="10" rx="3" fill="rgba(255,255,255,0.15)" />
			<rect x="22" y="174" width="110" height="10" rx="3" fill="rgba(255,255,255,0.15)" />

			<!-- Main content -->
			<rect x="220" y="80" width="320" height="26" rx="6" fill="url(#ph-accent)" opacity="0.85" />
			<rect x="220" y="124" width="480" height="12" rx="3" fill="rgba(255,255,255,0.18)" />
			<rect x="220" y="146" width="380" height="12" rx="3" fill="rgba(255,255,255,0.12)" />

			<!-- Placeholder thumbnails -->
			<rect x="220" y="186" width="220" height="120" rx="10" fill="rgba(0,255,102,0.05)" stroke="rgba(0,255,102,0.25)" stroke-width="1" />
			<rect x="460" y="186" width="240" height="120" rx="10" fill="rgba(167,139,250,0.05)" stroke="rgba(167,139,250,0.25)" stroke-width="1" />
			<rect x="220" y="326" width="240" height="120" rx="10" fill="rgba(77,255,216,0.05)" stroke="rgba(77,255,216,0.25)" stroke-width="1" />
			<rect x="480" y="326" width="220" height="120" rx="10" fill="rgba(0,255,102,0.05)" stroke="rgba(0,255,102,0.25)" stroke-width="1" />

			<!-- Center label -->
			<text x="400" y="250" text-anchor="middle" font-family="Inter, sans-serif" font-size="22" font-weight="800" fill="#f0f7f3" opacity="0.85">Kailand Launcher</text>
			<text x="400" y="278" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="500" fill="#8aa896">{label}</text>

			<!-- Bottom bar (action) -->
			<rect x="0" y="460" width="800" height="40" fill="rgba(5,10,8,0.6)" />
			<rect x="610" y="472" width="170" height="22" rx="6" fill="rgba(0,255,102,0.15)" stroke="rgba(0,255,102,0.5)" stroke-width="1" />
			<text x="695" y="487" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="700" fill="#00ff66">JUGAR</text>
		</svg>
	</div>
	{caption && <figcaption class="shot-caption">{caption}</figcaption>}
</figure>

<style>
	.shot {
		margin: 0;
	}
	.shot-frame {
		width: 100%;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--border-glow);
		background: #061410;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 24px rgba(0, 255, 102, 0.12);
		position: relative;
	}
	.shot-frame svg {
		width: 100%;
		height: 100%;
		display: block;
	}
	.shot-caption {
		margin-top: 0.6rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		text-align: center;
	}
</style>
