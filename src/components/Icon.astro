---
// Icon.astro
// Single source of truth for Tabler-style stroke icons.
// All glyphs share viewBox 0 0 24 24, stroke=currentColor, stroke-width=2.
// Add new icons by extending the `paths` map. Naming convention: Tabler icon names.

interface Props {
	name: string;
	size?: number;
	strokeWidth?: number;
}

const { name, size = 24, strokeWidth = 2 } = Astro.props;

const paths: Record<string, string> = {
	'shield-lock': '<path d="M12 3 4 6v6c0 5 3.5 7.5 8 9 4.5-1.5 8-4 8-9V6z"/><path d="M9 12l2 2 4-4"/>',
	'lock': '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
	'repeat': '<path d="M17 2l3 3-3 3"/><path d="M3 11V9a4 4 0 0 1 4-4h13"/><path d="M7 22l-3-3 3-3"/><path d="M21 13v2a4 4 0 0 1-4 4H4"/>',
	'puzzle': '<path d="M10 3h4a1 1 0 0 1 1 1v3a2 2 0 1 0 4 0V4a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v3a2 2 0 1 0 0 4h-3a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1h-3a2 2 0 1 0-4 0v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-3a2 2 0 1 0 0-4h3a1 1 0 0 0 1-1V4a1 1 0 0 1 1-1z"/>',
	'puzzle-2': '<path d="M10 3h4a1 1 0 0 1 1 1v3a2 2 0 1 0 4 0V4a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v3a2 2 0 1 0 0 4h-3a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1h-3a2 2 0 1 0-4 0v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-3a2 2 0 1 0 0-4h3a1 1 0 0 0 1-1V4a1 1 0 0 1 1-1z"/>',
	'rocket': '<path d="M4.5 16.5 3 21l4.5-1.5"/><path d="M14 4c3 0 7 3 7 7-2.5-1-5-1-7 1s-2 4.5-1 7c-4 0-7-3-7-7 2.5 1 5 1 7-1s2-4.5 1-7z"/><circle cx="15" cy="9" r="1" fill="currentColor"/>',
	'device-desktop': '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 20h8M12 16v4"/>',
	'terminal-2': '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M13 15h4"/>',
	'adjustments-alt': '<path d="M4 6h10M18 6h2"/><circle cx="16" cy="6" r="2"/><path d="M4 12h2M10 12h10"/><circle cx="8" cy="12" r="2"/><path d="M4 18h14M20 18h.01"/><circle cx="18" cy="18" r="2"/>',
	'trending-up': '<path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v4h-4"/>',
	'brand-tiktok': '<path d="M16 4c.5 2.5 2 4 4.5 4.5V11c-1.7 0-3.3-.5-4.5-1.4V17a5 5 0 1 1-5-5c.3 0 .7 0 1 .1v3.1a2 2 0 1 0 1 1.8V4z"/>',
	'brand-youtube': '<path d="M22 8.5a3 3 0 0 0-3-3 60 60 0 0 0-14 0 3 3 0 0 0-3 3 60 60 0 0 0 0 7 3 3 0 0 0 3 3 60 60 0 0 0 14 0 3 3 0 0 0 3-3 60 60 0 0 0 0-7z"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>',
	'brand-instagram': '<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="4"/><circle cx="16.5" cy="7.5" r="1" fill="currentColor"/>'
};
---

<svg
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={paths[name] ?? ''}
/>
