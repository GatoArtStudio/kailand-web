---
interface Props {
	title: string;
	href: string;
	img?: string;
	label?: string;
	animation?: string;
	animation_time?: string;
}

const {
	href,
	title,
	img,
	label,
	animation = 'fade-up',
	animation_time = '0'
} = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="social-btn"
	data-aos={animation}
	data-aos-delay={animation_time}
>
	<span class="social-icon" aria-hidden="true">
		{img && <img src={img} alt="" />}
	</span>
	<span class="social-text">
		<span class="social-title">{title}</span>
		{label && <span class="social-label">{label}</span>}
	</span>
	<span class="social-shine" aria-hidden="true"></span>
</a>

<style>
	.social-btn {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		max-width: 420px;
		padding: 0.9rem 1.25rem;
		border-radius: 12px;
		background: rgba(10, 20, 15, 0.5);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border: 1px solid var(--border-glow);
		color: var(--text-primary);
		text-decoration: none;
		overflow: hidden;
		transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}
	.social-btn::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent, rgba(0, 255, 102, 0.18), transparent);
		transform: translateX(-100%);
		transition: transform 0.6s ease;
		pointer-events: none;
	}
	.social-btn:hover {
		transform: translateY(-3px);
		border-color: var(--green-neon);
		background: rgba(0, 255, 102, 0.08);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 24px rgba(0, 255, 102, 0.3);
	}
	.social-btn:hover::before { transform: translateX(100%); }

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(0, 255, 102, 0.1);
		border: 1px solid var(--border-glow);
		flex-shrink: 0;
	}
	.social-icon img {
		width: 22px;
		height: 22px;
		filter: invert(1);
	}

	.social-text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}
	.social-title {
		font-weight: 700;
		font-size: 1rem;
		color: var(--text-primary);
	}
	.social-label {
		font-size: 0.82rem;
		color: var(--text-muted);
		margin-top: 2px;
	}

	.social-shine {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 80px;
		background: linear-gradient(120deg, transparent, rgba(255,255,255,0.25), transparent);
		transform: skewX(-20deg) translateX(-150%);
		transition: transform 0.7s ease;
		opacity: 0;
		pointer-events: none;
	}
	.social-btn:hover .social-shine {
		opacity: 1;
		transform: skewX(-20deg) translateX(420px);
	}
</style>
