---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Section from '../components/Section.astro';
import 'aos/dist/aos.css';

const features = [
	{
		icon: '🛡️',
		accent: 'green',
		title: 'AntiCheat propio',
		body: 'Sistema de protección desarrollado a medida, con archivos encriptados para evitar bypass y mantener la justicia.',
		href: '/launcher'
	},
	{
		icon: '🎮',
		accent: 'cyan',
		title: 'Mods personalizados',
		body: 'Decenas de items, armas y mecánicas únicas que no encontrarás en ningún otro servidor de Minecraft.',
		href: '/launcher'
	},
	{
		icon: '🚀',
		accent: 'violet',
		title: 'Launcher oficial',
		body: 'Instalador dedicado para Windows y Linux con actualizaciones automáticas y mods preconfigurados.',
		href: '/launcher'
	}
];

const socials = [
	{ icon: '▶', accent: 'red', title: 'YouTube', body: '@Kailandserver', href: 'https://www.youtube.com/@Kailandserver' },
	{ icon: '♪', accent: 'green', title: 'TikTok', body: '@kailandclips', href: 'https://www.tiktok.com/@kailandclips' },
	{ icon: '✦', accent: 'violet', title: 'Instagram', body: '@kailandclips', href: 'https://www.instagram.com/kailandclips/' }
];
---

<Layout>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-inner">
				<span class="hero-badge" data-aos="fade-down">
					<span class="hero-badge-dot"></span>
					Servidor de Minecraft · Temporada 5
				</span>
				<h1 class="hero-title" data-aos="fade-zoom-in" data-aos-delay="100">
					Bienvenido a
					<span class="hero-wordmark text-gradient animation-parpadeo display" transition:name="kailand-wordmark">Kailand</span>
				</h1>
				<p class="hero-tagline" data-aos="fade-up" data-aos-delay="200">
					Cada bloque, cada aventura, pensados para brindarte el máximo entretenimiento y desafíos épicos.
				</p>
				<div class="hero-cta" data-aos="fade-up" data-aos-delay="350">
					<a href="/discord" class="btn-neon">
						Entrar al Discord
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</a>
					<a href="/launcher" class="btn-ghost">Ver el Launcher</a>
				</div>
			</div>
			<div class="hero-scroll" aria-hidden="true">
				<span class="hero-scroll-line"></span>
			</div>
		</section>

		<!-- ABOUT -->
		<Section
			eyebrow="Sobre Nosotros"
			title="Un proyecto, una comunidad, mil aventuras"
			subtitle=" Aunque ya no somos un servidor público, seguimos comprometidos con el máximo entretenimiento a través de contenido de alta calidad. Síguenos en nuestras redes para estar al tanto de todas las novedades."
			align="center"
		>
			<ul role="list" class="feature-grid">
				{features.map((f) => (
					<Card
						title={f.title}
						body={f.body}
						href={f.href}
						icon={f.icon}
						accent={f.accent}
						animation="fade-up"
						target="_self"
					/>
				))}
			</ul>
		</Section>

		<!-- CTA LAUNCHER -->
		<section class="cta-block">
			<div class="glass cta-card" data-aos="zoom-in-up">
				<span class="cta-eyebrow">Launcher · Estado</span>
				<h2 class="cta-title display">¿Listo para empezar a jugar?</h2>
				<p class="cta-text">
					Descarga el launcher oficial de Kailand para Windows o Linux. Actualizaciones automáticas,
					mods preconfigurados y AntiCheat encriptado.
				</p>
				<div class="cta-actions">
					<a href="/launcher" class="btn-neon">Ir a la descarga</a>
					<span class="cta-note">Actualmente deshabilitado temporalmente</span>
				</div>
			</div>
		</section>

		<!-- REDES TEASER -->
		<Section
			eyebrow="Redes"
			title="Síguenos en nuestras redes"
			subtitle="Contento, clips y novedades: ahí lo posteamos todo."
			align="center"
		>
			<ul role="list" class="feature-grid sm">
				{socials.map((s) => (
					<Card
						title={s.title}
						body={s.body}
						href={s.href}
						target="_blank"
						icon={s.icon}
						accent={s.accent === 'red' ? 'green' : s.accent}
						animation="fade-up"
					/>
				))}
			</ul>
			<div class="redes-cta">
				<a href="/redes" class="btn-ghost">Ver todas las redes</a>
			</div>
		</Section>
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
	}

	/* HERO */
	.hero {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 6rem 1.5rem 4rem;
		text-align: center;
	}
	.hero-inner {
		max-width: 820px;
	}
	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.9rem;
		border-radius: 100px;
		background: rgba(0, 255, 102, 0.08);
		border: 1px solid var(--border-glow);
		color: var(--green-neon);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		margin-bottom: 1.75rem;
	}
	.hero-badge-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--green-neon);
		box-shadow: 0 0 8px var(--green-neon);
		animation: pulse-glow 2.5s ease-in-out infinite;
	}
	.hero-title {
		margin: 0;
		font-size: clamp(2.5rem, 9vw, 6rem);
		font-weight: 800;
		line-height: 1.05;
		color: var(--text-primary);
		letter-spacing: -0.03em;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: center;
	}
	.hero-wordmark {
		font-size: clamp(3rem, 11vw, 7.5rem);
		display: inline-block;
		filter: drop-shadow(0 0 30px rgba(0, 255, 102, 0.45));
	}
	.hero-tagline {
		margin: 1.75rem auto 0;
		max-width: 55ch;
		font-size: clamp(1rem, 2vw, 1.25rem);
		color: var(--text-primary);
		opacity: 0.85;
		line-height: 1.6;
	}
	.hero-cta {
		margin-top: 2.25rem;
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.hero-scroll {
		margin-top: 3rem;
		width: 1px;
		height: 60px;
		position: relative;
		overflow: hidden;
	}
	.hero-scroll-line {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 50%;
		background: linear-gradient(to bottom, transparent, var(--green-neon));
		animation: scroll-pulse 2s ease-in-out infinite;
	}
	@keyframes scroll-pulse {
		0% { transform: translateY(-100%); }
		100% { transform: translateY(200%); }
	}

	/* FEATURE GRID (reused) */
	.feature-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}
	.feature-grid.sm {
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	}

	/* CTA BLOCK */
	.cta-block {
		max-width: 1100px;
		margin: 2rem auto;
		padding: 0 1.5rem;
	}
	.cta-card {
		padding: 3rem;
		text-align: center;
		position: relative;
		overflow: hidden;
	}
	.cta-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 50% 0%, rgba(0, 255, 102, 0.15), transparent 60%);
		pointer-events: none;
	}
	.cta-eyebrow {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--violet-accent);
		margin-bottom: 1rem;
	}
	.cta-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		margin: 0 0 1rem;
		position: relative;
	}
	.cta-text {
		max-width: 50ch;
		margin: 0 auto 2rem;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
		position: relative;
	}
	.cta-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		position: relative;
	}
	.cta-note {
		font-size: 0.85rem;
		color: var(--text-muted);
		font-style: italic;
	}

	.redes-cta {
		text-align: center;
		margin-top: 1.75rem;
	}

	@media (max-width: 600px) {
		.hero-cta { flex-direction: column; align-items: stretch; }
		.btn-neon, .btn-ghost { width: 100%; }
		.cta-card { padding: 2rem 1.25rem; }
	}
</style>
