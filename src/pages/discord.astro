---
import Layout from '../layouts/Layout.astro';
import DiscordIcon from '../icons/brand-discord.svg';
import 'aos/dist/aos.css';
---

<Layout
	url="https://www.kailand.es/discord"
	title="Kailand · Discord"
	description="Redirigiendo a la invitación oficial de Discord de Kailand."
>
	<main class="redir">
		<div class="redir-inner" data-aos="fade-zoom-in" data-aos-delay="100">
			<div class="redir-icon animation-float">
				<img src={DiscordIcon.src} alt="" />
			</div>
			<h1 class="redir-title display">Redirigiendo a Discord…</h1>
			<p class="redir-text">¡Descubre Kailand! Te estamos llevando a la invitación del servidor.</p>
			<p class="redir-fallback">
				¿No te redirigió? <a href="https://discord.com/invite/chwAE86T6W" class="redir-link">Abrir Discord manualmente</a>
			</p>
		</div>
	</main>
</Layout>
<script>
	document.addEventListener("astro:page-load", async () => {
		await new Promise(resolve => setTimeout(resolve, 2000));
		window.location.href = "https://discord.com/invite/chwAE86T6W";
	})
</script>

<style>
	.redir {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 6rem 1.5rem 4rem;
	}
	.redir-inner {
		max-width: 480px;
	}
	.redir-icon {
		width: 96px;
		height: 96px;
		margin: 0 auto 1.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 24px;
		background: rgba(88, 101, 242, 0.15);
		border: 1px solid rgba(88, 101, 242, 0.5);
		box-shadow: 0 0 30px rgba(88, 101, 242, 0.3);
	}
	.redir-icon img {
		width: 48px;
		height: 48px;
		filter: invert(1);
	}
	.redir-title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.6rem, 4vw, 2.25rem);
		font-weight: 800;
		color: var(--text-primary);
	}
	.redir-text {
		margin: 0 0 1rem;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}
	.redir-fallback {
		font-size: 0.88rem;
		color: var(--text-muted);
	}
	.redir-link {
		color: var(--green-neon);
		text-decoration: none;
		font-weight: 600;
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}
	.redir-link:hover { border-color: var(--green-neon); }
</style>
