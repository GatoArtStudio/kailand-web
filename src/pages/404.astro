---
import Layout from '../layouts/Layout.astro';
import 'aos/dist/aos.css';
---

<Layout title="Kailand · Página no encontrada">
	<main class="err">
		<div class="err-inner" data-aos="fade-zoom-in" data-aos-delay="100">
			<span class="err-code display text-gradient">404</span>
			<h1 class="err-title display">Página no encontrada</h1>
			<p class="err-text">
				El recurso que intentas cargar no existe o no estás autorizado a verlo.
			</p>
			<a href="/" class="btn-neon">
				Volver al inicio
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
			</a>
		</div>
	</main>
</Layout>

<style>
	.err {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 6rem 1.5rem 4rem;
	}
	.err-inner {
		max-width: 500px;
	}
	.err-code {
		font-size: clamp(6rem, 18vw, 11rem);
		font-weight: 900;
		line-height: 0.9;
		display: block;
		margin-bottom: 1rem;
		filter: drop-shadow(0 0 30px rgba(0, 255, 102, 0.4));
	}
	.err-title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		font-weight: 800;
		color: var(--text-primary);
	}
	.err-text {
		margin: 0 0 2rem;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}
</style>
