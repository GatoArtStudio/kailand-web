---
import Layout from '../layouts/Layout.astro';
import ButtomCard from '../components/ButtomCard.astro';
import faviconImg from '../assets/img/generic/favicon.png';
import YouTubeIcon from '../icons/brand-youtube.svg';
import TiktokIcon from '../icons/brand-tiktok.svg';
import InstagramIcon from '../icons/brand-instagram.svg';
import DiscordIcon from '../icons/brand-discord.svg';
import WebIcon from '../icons/brand-web.svg';
import GmailIcon from '../icons/brand-gmail.svg';
import 'aos/dist/aos.css';

const socials = [
	{ title: 'Página Web',  href: 'https://www.kailand.es/',       img: WebIcon.src,      label: 'kailand.es',             delay: '0'   },
	{ title: 'YouTube',     href: 'https://www.youtube.com/@Kailandserver', img: YouTubeIcon.src, label: '@Kailandserver',  delay: '80'  },
	{ title: 'TikTok',      href: 'https://www.tiktok.com/@kailandclips',   img: TiktokIcon.src,   label: '@kailandclips',    delay: '160' },
	{ title: 'Instagram',   href: 'https://www.instagram.com/kailandclips/', img: InstagramIcon.src, label: 'kailandclips',  delay: '240' },
	{ title: 'Discord',     href: '/discord',                          img: DiscordIcon.src,  label: 'Únete al servidor', delay: '320' },
	{ title: 'Correo',      href: 'mailto:kailandservidor@gmail.com',  img: GmailIcon.src,    label: 'kailandservidor@gmail.com', delay: '400' }
];
---

<Layout
	url="https://www.kailand.es/redes"
	title="Kailand · Redes"
	description="Todas las redes sociales y enlaces de contacto de Kailand en un solo lugar."
>
	<main>
		<section class="hero">
			<div class="hero-inner">
				<span class="hero-badge" data-aos="fade-down">
					<span class="hero-badge-dot"></span>
					Comunidad
				</span>
				<h1 class="hero-title display" data-aos="fade-zoom-in" data-aos-delay="100">
					Nuestras <span class="text-gradient">redes</span>
				</h1>
				<p class="hero-tagline" data-aos="fade-up" data-aos-delay="200">
					Contento, clips y novedades del proyecto. Síguenos en tu plataforma favorita y únete a la comunidad.
				</p>
			</div>
		</section>

		<!-- FLIP CARD -->
		<section class="flip-block">
			<div class="flip-card" data-aos="zoom-in">
				<div class="flip-content">
					<div class="flip-front glass">
						<div class="flip-photo">
							<img src={faviconImg.src} alt="" class="flip-logo" />
						</div>
						<strong class="flip-title display text-gradient">Kailand</strong>
						<span class="flip-subtitle">Servidor de Minecraft · Temporada 5</span>
					</div>
					<div class="flip-back glass">
						<span class="flip-back-eyebrow">Sobre Nosotros</span>
						<p class="flip-back-text">
							Servidor de Minecraft diseñado y desarrollado profesionalmente para ofrecerte
							una experiencia única. Cada bloque y cada aventura están pensados para brindarte
							el máximo entretenimiento y desafíos épicos.
						</p>
						<span class="flip-back-foot">Kailand &nbsp;|&nbsp; Temporada 5</span>
					</div>
				</div>
				<span class="flip-hint" aria-hidden="true">Pasa el cursor para girar ↺</span>
			</div>
		</section>

		<!-- SOCIAL GRID -->
		<section class="social-block">
			<div class="social-grid">
				{socials.map((s) => (
					<ButtomCard
						title={s.title}
						href={s.href}
						img={s.img}
						label={s.label}
						animation="fade-up"
						animation_time={s.delay}
					/>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	main { min-height: 100vh; padding-top: 80px; }

	.hero {
		text-align: center;
		padding: 4rem 1.5rem 1rem;
	}
	.hero-inner { max-width: 720px; margin: 0 auto; }

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.9rem;
		border-radius: 100px;
		background: rgba(0, 255, 102, 0.08);
		border: 1px solid var(--border-glow);
		color: var(--green-neon);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: 1.25rem;
	}
	.hero-badge-dot {
		width: 8px; height: 8px;
		border-radius: 50%;
		background: var(--green-neon);
		box-shadow: 0 0 8px var(--green-neon);
		animation: pulse-glow 2.5s ease-in-out infinite;
	}

	.hero-title {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		font-weight: 900;
		letter-spacing: -0.03em;
		color: var(--text-primary);
	}
	.hero-tagline {
		margin: 1.25rem auto 0;
		max-width: 50ch;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	/* FLIP CARD */
	.flip-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 2.5rem 1.5rem;
	}
	.flip-card {
		width: 320px;
		height: 380px;
		max-width: 90vw;
		position: relative;
		perspective: 1400px;
	}
	.flip-content {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transition: transform 0.7s cubic-bezier(0.4, 0.2, 0.2, 1);
	}
	.flip-card:hover .flip-content,
	.flip-card:focus-within .flip-content { transform: rotateY(180deg); }

	.flip-front, .flip-back {
		position: absolute;
		inset: 0;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		border-radius: 18px;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}
	.flip-front {
		background:
			radial-gradient(ellipse at 50% 0%, rgba(0, 255, 102, 0.15), transparent 70%),
			rgba(10, 20, 15, 0.55);
	}
	.flip-front::before {
		content: '';
		position: absolute;
		inset: -2px;
		border-radius: 18px;
		padding: 2px;
		background: linear-gradient(135deg, var(--green-neon), var(--violet-accent), var(--cyan-accent));
		-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		opacity: 0.6;
		pointer-events: none;
	}
	.flip-photo {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		overflow: hidden;
		border: 2px solid var(--green-neon);
		box-shadow: 0 0 30px rgba(0, 255, 102, 0.4);
		background: rgba(5, 10, 8, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.flip-logo { width: 100%; height: 100%; object-fit: contain; }
	.flip-title { font-size: 2rem; font-weight: 900; }
	.flip-subtitle { font-size: 0.85rem; color: var(--text-muted); letter-spacing: 0.06em; }

	.flip-back {
		transform: rotateY(180deg);
		background:
			radial-gradient(ellipse at 50% 100%, rgba(167, 139, 250, 0.15), transparent 70%),
			rgba(10, 20, 15, 0.65);
		gap: 1rem;
	}
	.flip-back-eyebrow {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--violet-accent);
	}
	.flip-back-text {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--text-primary);
		opacity: 0.9;
	}
	.flip-back-foot {
		margin-top: auto;
		font-size: 0.75rem;
		color: var(--text-muted);
		letter-spacing: 0.06em;
	}

	.flip-hint {
		margin-top: 1rem;
		font-size: 0.8rem;
		color: var(--text-muted);
		opacity: 0.7;
	}
	@media (hover: none) {
		.flip-hint { display: none; }
	}

	/* SOCIAL GRID */
	.social-block {
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}
	.social-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1rem;
		max-width: 480px;
		margin: 0 auto;
	}
</style>
