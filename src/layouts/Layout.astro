---
import { ClientRouter } from 'astro:transitions';
import '../../global.css';
import backgroundAnimated from "../assets/img/generic/background_web_2.webm";
import faviconImg from '../assets/img/generic/favicon.png';
import klzImg from '../assets/img/generic/KLZ.gif';
import NavBar from '../components/NavBar.astro';

interface Props {
	title?: string;
	description?: string;
	url?: string;
}

const {
	url = "https://www.kailand.es",
	title = "Kailand · Tu aventura definitiva en Minecraft",
	description = "Únete a Kailand, un servidor de Minecraft desarrollado profesionalmente para ofrecerte una experiencia única y emocionante."
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={klzImg.src}>
		<meta property="og:url" content={url}>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={faviconImg.src} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap" rel="stylesheet">
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<video transition:persist autoplay loop muted playsinline class="photo_bg" aria-hidden="true">
			<source src={backgroundAnimated} type="video/webm">
		</video>
		<div class="bg-overlay" aria-hidden="true"></div>

		<NavBar />
		<slot />

		<footer class="site-footer">
			<div class="line-gradient"></div>
			<div class="footer-inner glass-only">
				<a href="/" class="footer-logo display text-gradient" transition:name="kailand-wordmark">Kailand</a>
				<span class="footer-copy">© 2024 - 2026 Kailand · Casi todos los derechos reservados.</span>
				<nav class="footer-links">
					<a href="/redes">Redes</a>
					<a href="/launcher">Launcher</a>
					<a href="/policies">Privacidad</a>
					<a href="/discord">Discord</a>
					<a href="https://gatoartstudio.com">Desarrollador</a>
				</nav>
			</div>
		</footer>

		<script src="../js/main.js"></script>
	</body>
</html>

<script>
	document.addEventListener("astro:page-load", () => {
		const video = document.querySelector(".photo_bg") as HTMLVideoElement;

		if (video) {
			video.load();
			video.play().catch((error) => {
				console.error("Error playing background video: ", error);
			});
		}
	});
</script>

<style is:global>
	body {
		position: relative;
		min-height: 100vh;
		overflow-x: hidden;
		background: linear-gradient(180deg, #050a08 0%, #030d08 100%);
	}

	.photo_bg {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
		opacity: 0.85;
		pointer-events: none;
	}

	/* Overlay gradient for readability without hiding the webm */
	.bg-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
		background:
			radial-gradient(ellipse at 50% 0%, transparent 0%, rgba(5, 10, 8, 0.55) 70%),
			linear-gradient(180deg, rgba(5, 10, 8, 0.5) 0%, rgba(5, 10, 8, 0.92) 100%);
	}

	/* Content above the backdrop */
	body > :not(.photo_bg):not(.bg-overlay) {
		position: relative;
		z-index: 2;
	}

	/* Footer */
	.site-footer {
		margin-top: 4rem;
		padding: 2rem 1.5rem 2.5rem;
	}
	.footer-inner {
		max-width: 1100px;
		margin: 30px auto 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}
	.footer-logo {
		font-size: 1.6rem;
		font-weight: 900;
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.footer-copy {
		color: var(--text-muted);
		font-size: 0.85rem;
		letter-spacing: 0.04em;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.25rem;
		margin-top: 0.25rem;
	}
	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}
	.footer-links a:hover {
		color: var(--green-neon);
	}
</style>
