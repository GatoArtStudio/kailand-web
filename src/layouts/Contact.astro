---
import { ClientRouter } from 'astro:transitions';
import '../../global.css';
import backgroundAnimated from "../assets/img/generic/background_web_2.webm";
import faviconImg from '../assets/img/generic/favicon.png';
import klzImg from '../assets/img/generic/KLZ.gif';
interface Props {
	title?: string;
	description?: string;
	url?: string;
}

const { url = "https://www.kailand.es/redes", title = "Descubre Kailand: Todas las redes de Kailand", description = "Únete a Kailand, un servidor público de Minecraft desarrollado profesionalmente para ofrecerte una experiencia única y emocionante." } = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description} >
		<meta property="og:image" content={klzImg.src}>
		<meta property="og:url" content={url}>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={faviconImg.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Anton&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
		<ClientRouter />
	</head>
	<body class="bg-linear-to-r from-slate-900 via-green-950 to-indigo-950">
		<video autoplay loop muted playsinline class="photo_bg" data-aos="fade-zoom-in" data-aos-delay="200">
			<source src={backgroundAnimated} type="video/webm">
		</video>
		<slot />
		<div style="text-align: center">
			<span class="logo my-9">
				© 2024 Kailand. All rights reserved
			</span>
		</div>
	</body>
</html>
<style is:global>
	:root {
		--accent: 0, 255, 0;
		--accent-light: 224, 204, 250;
		--accent-dark: 0, 130, 0;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 35%,
			rgb(255, 255, 255) 90%
		);
	}
	html {
		font-family: system-ui, sans-serif;
		background-size: 224px;
	}
	html::-webkit-scrollbar {
		display: none;
	}
	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}
	.photo_bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -1;
		mask-image: linear-gradient(black 5%, transparent 40%);
	}
	slot {
		z-index: 1;
	}
	.logo {
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 40px;
		display: inline-block;
		text-shadow: 0 0 50px rgb(0, 255, 0);
	}
</style>
